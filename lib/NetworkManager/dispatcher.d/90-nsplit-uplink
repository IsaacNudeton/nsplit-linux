#!/bin/sh
# 90-nsplit-uplink : NetworkManager dispatcher hook (install as /etc/NetworkManager/dispatcher.d/90-nsplit-uplink, root:root 755).
# nsplit forwards a namespace's traffic only on interfaces that have net.ipv4.conf.<if>.forwarding=1, set by `nsplit-fw up`. That flag belongs to the interface object: when an
# uplink is recreated (Wi-Fi driver reset, hot-plug) it is back at the default (0) and the namespaces silently lose the internet while every nsplit unit still says "active".
# This hook asks the firewall unit to RELOAD (the existing ExecReload = `nsplit-fw up` on loaded tables: atomic ruleset reload + forwarding re-assert; a failed reload keeps the
# old rules and the recorded rollback values) -- and ONLY when a CURRENT-STATE check shows it is needed:
#   * action is `up` and the interface is one of UPLINKS                              (anything else: exit 0, nothing asked)
#   * the interface exists NOW and is up NOW                                          (a late/obsolete event for a vanished or downed interface: nothing asked)
#   * nsplit-firewall.service is `active` NOW                                         (a deliberately stopped, stopping, failed or never-started nsplit is never touched; a reload
#                                                                                      cannot start a unit, and nothing here ever starts, stops or restarts anything)
#   * the nsplit tables are loaded NOW                                                (tables missing while the unit says active is an abnormal state: a reload would take the
#                                                                                      first-start path of nsplit-fw, whose failure handling tears down and kills sessions. That is
#                                                                                      not recovery: it is logged and left to the operator; the split is never re-created here)
#   * forwarding on that interface is not 1                                            (already correct = duplicate event = nothing asked)
# Serialization with firewall operations is systemd's: the reload is a systemd job on the unit (never `nsplit-fw` run directly), so it is ordered with stop/restart/reload jobs of
# the same unit; `--no-block` so NetworkManager is never delayed. Always exits 0.
ETC=${NSPLIT_ETC:-/etc/nsplit}; SYSTEMCTL=${NSPLIT_SYSTEMCTL:-systemctl}; LOGGER=${NSPLIT_LOGGER:-logger}; SYSNET=${NSPLIT_SYSNET:-/sys/class/net}
NFT=${NSPLIT_NFT:-nft}; SYSCTL_DIR=${NSPLIT_SYSCTL_DIR:-/proc/sys/net/ipv4/conf}
iface=${1:-}; action=${2:-}
log() { "$LOGGER" -t nsplit-uplink "$*" 2>/dev/null; }
[ "$action" = up ] || exit 0
[ -n "$iface" ] || exit 0
case "$iface" in */*|.*) exit 0 ;; esac
uplinks=$( . "$ETC/nsplit.conf" 2>/dev/null && printf %s "$UPLINKS" ) || exit 0
case " $uplinks " in *" $iface "*) ;; *) exit 0 ;; esac
[ -d "$SYSNET/$iface" ] || { log "$iface up event is obsolete: the interface no longer exists; nothing done"; exit 0; }
[ "$(cat "$SYSNET/$iface/operstate" 2>/dev/null)" = up ] || { log "$iface up event is obsolete: the interface is not up now; nothing done"; exit 0; }
"$SYSTEMCTL" is-active --quiet nsplit-firewall.service || exit 0
"$NFT" list table inet nsplit >/dev/null 2>&1 || { log "$iface up: nsplit-firewall says active but the nsplit tables are not loaded; NOT reloading (that would re-create the split); investigate"; exit 0; }
[ "$(cat "$SYSCTL_DIR/$iface/forwarding" 2>/dev/null)" = 1 ] && exit 0
if "$SYSTEMCTL" --no-block reload nsplit-firewall.service; then
	log "$iface up with forwarding not in place: asked nsplit-firewall to reload (re-applies forwarding on the uplinks)"
else
	log "$iface up: could not queue a reload of nsplit-firewall (namespaces may lack forwarding on $iface)"
fi
exit 0
