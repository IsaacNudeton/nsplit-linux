[Unit]
Description=nsplit split resolver for profile %i, INSIDE netns-%i (tailnet names to Tailscale, everything else to the public resolvers)
ConditionPathExists=/etc/nsplit/dns/%i.conf
Requires=nsplit-netns@%i.service nsplit-firewall.service
BindsTo=nsplit-netns@%i.service nsplit-firewall.service
After=nsplit-netns@%i.service nsplit-firewall.service nsplit-tailscaled@%i.service

[Service]
Type=simple
User=dnsmasq
NetworkNamespacePath=/run/netns/netns-%i
InaccessiblePaths=-/run/systemd/resolve -/var/lib/tailscale
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ExecStartPre=/usr/bin/dnsmasq --test --conf-file=/etc/nsplit/dns/%i.conf
ExecStart=/usr/bin/dnsmasq --keep-in-foreground --conf-file=/etc/nsplit/dns/%i.conf
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
