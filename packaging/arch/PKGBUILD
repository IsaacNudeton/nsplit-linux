# Maintainer: Isaac Nudeton
# Build:  make dist && cp nsplit-*.tar.gz packaging/arch/ && (cd packaging/arch && makepkg -f)
pkgname=nsplit
pkgver=0.2.0alpha.3
pkgrel=1
pkgdesc='Per-profile Tailscale networking for shared Linux computers: each selected user gets their own network and tailnet'
arch=(any)
license=(MIT)
depends=(bash iproute2 nftables python tailscale dnsmasq bind util-linux systemd pam dbus acl)
optdepends=('sudo: lets each profile owner sign in and finish their own DNS without an administrator (one fixed rule per profile)'
            'ufw: routed traffic rules are added when ufw is active'
            'openssh: --ssh openssh (a separate SSH server inside the namespace)'
            'networkmanager: the uplink hook re-applies forwarding after a Wi-Fi/driver reset')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=(SKIP)
package() {
	cd "$srcdir/$pkgname-$pkgver"
	make PREFIX=/usr DESTDIR="$pkgdir" install
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
