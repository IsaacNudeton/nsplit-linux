# generated by nsplit for profile @NAME@. Runs INSIDE netns-@NAME@ as user dnsmasq (nsplit-dns@@NAME@.service).
listen-address=127.0.0.1
bind-interfaces
port=53
pid-file=
log-facility=-
no-resolv
no-hosts
# plain (dot-less) names are NEVER forwarded to a public resolver: a short name only ever reaches Tailscale's resolver via the search domain
domain-needed
cache-size=0
# every ts.net name (the profile's tailnet and shared-in nodes) goes ONLY to Tailscale's resolver; if it is down they FAIL, they do not fall through
server=/ts.net/100.100.100.100
@PUBLIC_SERVERS@
